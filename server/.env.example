# Copy to .env and fill in real values for production
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/codefolio
JWT_SECRET=change-me-in-production

# SMTP (optional). Without these, contact-form emails are logged to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CodeFolio <noreply@codefolio.dev>"
